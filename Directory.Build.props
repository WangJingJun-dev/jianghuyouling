<Project>
  <!--
    Machine-local overrides are generated by tools/bootstrap-development.ps1 and
    deliberately stay out of Git. TAIWU_GAME_DIR is also accepted for ephemeral CI/shell use.
  -->
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.local.props"
          Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.local.props')" />

  <PropertyGroup>
    <TaiwuGameDir Condition="'$(TaiwuGameDir)' == '' and '$(TAIWU_GAME_DIR)' != ''">$(TAIWU_GAME_DIR)</TaiwuGameDir>
    <TaiwuGameDir Condition="'$(TaiwuGameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\The Scroll Of Taiwu</TaiwuGameDir>
  </PropertyGroup>
</Project>
